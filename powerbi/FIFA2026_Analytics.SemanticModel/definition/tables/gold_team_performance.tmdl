table gold_team_performance
	lineageTag: 60e41612-bc2a-4b00-a9a7-a7e2ba88e5fb

	measure 'Total Teams' = COUNTROWS(gold_team_performance)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: m005-total-teams

	measure 'Selected Matches' = SUM(gold_team_performance[matches])
		formatString: #,0
		displayFolder: KPIs
		lineageTag: m006-sel-matches

	measure 'Selected Wins' = SUM(gold_team_performance[wins])
		formatString: #,0
		displayFolder: KPIs
		lineageTag: m007-sel-wins

	measure 'Selected Win Pct' = AVERAGE(gold_team_performance[win_pct])
		formatString: 0.0
		displayFolder: KPIs
		lineageTag: m008-sel-win-pct

	measure 'Selected WC Wins' = SUM(gold_team_performance[wc_wins])
		formatString: #,0
		displayFolder: KPIs
		lineageTag: m009-sel-wc-wins

