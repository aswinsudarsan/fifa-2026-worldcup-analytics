model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["gold_team_performance","gold_wc2026_predictions","gold_fact_matches"]

annotation PBI_ProTooling = ["DevMode"]

ref table gold_team_performance
ref table gold_wc2026_predictions
ref table gold_fact_matches

ref cultureInfo en-US

